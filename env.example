# Copy this file to .env and fill in your actual values

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/tourist_app

# Session Configuration
SESSION_SECRET= ego is everything

# Server Configuration
PORT=8080
NODE_ENV=development
# Optional: max /api requests per minute per user (JWT) or per IP (default 600, capped 5000)
# API_RATE_LIMIT_MAX_PER_MINUTE=600

# JWT Configuration
JWT_SECRET=your-jwt-secret

# --- In-app WebRTC calls (cross-network audio needs TURN, not just STUN) ---
# Prefer one of these (checked in order by GET /api/webrtc/ice-servers):
#
# 1) Twilio Network Traversal (reuses WhatsApp OTP Twilio credentials if set):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
#
# 2) Metered.ca TURN (free tier available):
# METERED_DOMAIN=gbrides.metered.live
# METERED_SECRET_KEY=   # from Dashboard → Developers (Secret Key)
# # alias also accepted: METERED_API_KEY=<same secret>
# # optional: METERED_CREDENTIAL_TTL_SECONDS=14400
# # optional: METERED_CREDENTIAL_API_KEY=<credential-scoped key from Add Credential>
#
# 3) Self-hosted coturn with shared secret (HMAC time-limited creds):
# TURN_URLS=turn:turn.example.com:3478,turn:turn.example.com:443?transport=tcp
# TURN_SHARED_SECRET=
# TURN_CREDENTIAL_TTL_SECONDS=3600
#
# 4) Static long-term TURN credentials:
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:443?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=
